# Środowisko wirtualne Pythona.
.venv/
venv/
env/

# Pliki tymczasowe interpretera Pythona.
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
build/
dist/

# Wyniki narzędzi deweloperskich.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Katalog roboczy projektów użytkownika. Nigdy nie trafia do repozytorium,
# ponieważ zawiera prywatne materiały źródłowe i wyniki przetwarzania.
projekty/
Gemini Notebook Builder/

# Materiały kontekstowe projektu Claude. Zostają na dysku, ale nie trafiają do
# publicznego repozytorium. Opisują użytkownika i jego sposób pracy, plik stanu
# zawiera dodatkowo dosłowną kopię kodu, który w repozytorium już jest, a plik
# przekazania to kopia bloku wklejanego do projektu Claude na koniec etapu.
# Ich właściwym miejscem jest Wiedza i okno projektu Claude.
INSTRUKCJA_SYSTEMOWA_PROJEKTU.md
STAN_PROJEKTU.md
PRZEKAZANIE.md

# Lokalna konfiguracja i sekrety. Repozytorium jest publiczne, więc te pliki
# nie mogą się w nim znaleźć w żadnej postaci.
.env
*.local.toml
*.local.yaml
konfiguracja_lokalna.*
sekrety.*

# Cache aplikacji i bazy danych stanu.
cache/
*.sqlite
*.sqlite3
*.db

# Logi.
*.log
log_szczegolowy.txt
log_wazne.txt

# Raport diagnostyki zapisany do katalogu repozytorium podczas sprawdzania
# środowiska. Jest to wynik lokalnego uruchomienia, a nie część kodu.
/diagnostyka.txt

# Pliki systemowe Windows i macOS.
Thumbs.db
desktop.ini
.DS_Store

# Pliki tymczasowe edytorów.
*.swp
*~
.idea/
.vscode/
