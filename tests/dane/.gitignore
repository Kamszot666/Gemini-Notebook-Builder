# Środowisko wirtualne Pythona.
.venv/
venv/
env/

# Pliki tymczasowe interpretera Pythona.
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
build/
dist/

# Wyniki narzędzi deweloperskich.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Katalog roboczy projektów użytkownika. Nigdy nie trafia do repozytorium,
# ponieważ zawiera prywatne materiały źródłowe i wyniki przetwarzania.
projekty/
Gemini Notebook Builder/

# Lokalna konfiguracja i sekrety. Repozytorium jest publiczne, więc te pliki
# nie mogą się w nim znaleźć w żadnej postaci.
.env
*.local.toml
*.local.yaml
konfiguracja_lokalna.*
sekrety.*

# Cache aplikacji i bazy danych stanu.
cache/
*.sqlite
*.sqlite3
*.db

# Logi.
*.log
log_szczegolowy.txt
log_wazne.txt

# Pliki systemowe Windows i macOS.
Thumbs.db
desktop.ini
.DS_Store

# Pliki tymczasowe edytorów.
*.swp
*~
.idea/
.vscode/
