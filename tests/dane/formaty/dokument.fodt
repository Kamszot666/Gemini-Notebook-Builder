<office:meta><dc:title>Raport o żółwiach</dc:title><meta:initial-creator>Anna Nowak</meta:initial-creator><meta:creation-date>2026-03-14T10:00:00</meta:creation-date><dc:date>2026-04-02T12:30:00</dc:date></office:meta>
<office:automatic-styles>
<text:list-style style:name="Num"><text:list-level-style-number text:level="1" style:num-suffix="." style:num-format="1"/></text:list-style>
<text:list-style style:name="Pkt"><text:list-level-style-bullet text:level="1" text:bullet-char="•"/></text:list-style>
</office:automatic-styles>
<office:body><office:text>
<text:h text:outline-level="1">Wstęp do żółwi</text:h>
<text:p>Żółwie to <text:span>gady</text:span> pancerne. Zażółć gęślą jaźń.<text:s text:c="3"/>Koniec zdania.<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p>Przypis o pancerzu żółwia.</text:p></text:note-body></text:note></text:p>
<text:h text:outline-level="2">Gatunki</text:h>
<text:list text:style-name="Pkt"><text:list-item><text:p>żółw grecki</text:p></text:list-item><text:list-item><text:p>żółw błotny</text:p><text:list><text:list-item><text:p>podgatunek zagnieżdżony</text:p></text:list-item></text:list></text:list-item></text:list>
<text:list text:style-name="Num"><text:list-item><text:p>pierwszy krok</text:p></text:list-item><text:list-item><text:p>drugi krok</text:p></text:list-item></text:list>
<table:table table:name="Tabela1"><table:table-column table:number-columns-repeated="3"/>
<table:table-row><table:table-cell><text:p>Gatunek</text:p></table:table-cell><table:table-cell><text:p>Długość</text:p></table:table-cell><table:table-cell><text:p>Waga</text:p></table:table-cell></table:table-row>
<table:table-row><table:table-cell><text:p>grecki</text:p></table:table-cell><table:table-cell><text:p>25 cm</text:p></table:table-cell><table:table-cell><text:p>2 kg</text:p></table:table-cell></table:table-row>
<table:table-row><table:table-cell><text:p>błotny</text:p></table:table-cell><table:table-cell><text:p>20 cm</text:p></table:table-cell><table:table-cell><text:p>1 kg</text:p></table:table-cell></table:table-row>
</table:table>
<text:p>Ostatni akapit po tabeli.</text:p>
</office:text></office:body></office:document>
